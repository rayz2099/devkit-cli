set shell := ["zsh", "-lc"]

bin_dir := "./bin"
bin_name := "tl"
bin_path := bin_dir + "/" + bin_name

default:
    @just --list

help:
    @just --list

fmt:
    mise exec -- gofmt -w $(find . -name '*.go' -not -path './.git/*')

test:
    mise exec -- go test ./...

build:
    mkdir -p {{bin_dir}}
    mise exec -- go build -o {{bin_path}} ./cmd/tl

clean:
    bun -e 'import { rmSync } from "node:fs"; rmSync("{{bin_dir}}", { recursive: true, force: true });'

install:
    mise exec -- go install ./cmd/tl

run *args:
    mise exec -- go run ./cmd/tl {{args}}

completion-fish:
    @mise exec -- go run ./cmd/tl completion fish
